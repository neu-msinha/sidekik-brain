PORT=8082
REDIS_URL=redis://localhost:6379
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SK_INTERNAL_TOKEN=            # shared; openssl rand -hex 32 (from team vault)
LOG_LEVEL=info
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT_MS=1500           # per-call timeout and circuit-breaker slow-call threshold
OPENROUTER_API_KEY=           # fallback route for Jev
OPENROUTER_JEV_MODEL=typesafe/jev-1.13
OPENROUTER_DECISIONS_URL=        # optional; default OpenRouter. AI/ML API: https://api.aimlapi.com/v1/decisions (model typesafe/jev)
ANTHROPIC_API_KEY=
LLM_FALLBACK_MODEL=claude-haiku-4-5
GATEWAY_INTERNAL_URL=http://localhost:8080
JEV_RPS=30
JEV_TPS=80000
PLANNER_MODEL=claude-haiku-4-5
PERSISTENCE=supabase          # supabase | memory (memory = no database, e.g. dev:mock)
THRESHOLDS_JSON=              # optional overrides from scripts/calibrate.ts, e.g. {"pauseNow":0.8}
